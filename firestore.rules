rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isFacilitator() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'facilitator';
    }

    function hasMembership(workshopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workshops/$(workshopId)/members/$(request.auth.uid));
    }

    function memberTeam(workshopId) {
      return get(/databases/$(database)/documents/workshops/$(workshopId)/members/$(request.auth.uid)).data.teamId;
    }

    function ownsWorkshop(workshopId) {
      return isFacilitator()
        && get(/databases/$(database)/documents/workshops/$(workshopId)).data.facilitatorUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /workshops/{workshopId} {
      allow create: if isFacilitator()
        && request.resource.data.facilitatorUid == request.auth.uid;
      // El acceso de equipo necesita leer el estado para mostrar "cerrada", "pausada"
      // o "finalizada" antes de crear la membresía. Los datos de equipos siguen aislados.
      allow get: if signedIn();
      allow list: if isFacilitator()
        && resource.data.facilitatorUid == request.auth.uid;
      allow update, delete: if ownsWorkshop(workshopId);

      match /teamSecrets/{teamId} {
        allow read, create, update, delete: if ownsWorkshop(workshopId);
      }

      match /members/{userId} {
        allow read: if ownsWorkshop(workshopId) || (signedIn() && request.auth.uid == userId);
        allow create: if signedIn()
          && request.auth.uid == userId
          && get(/databases/$(database)/documents/workshops/$(workshopId)).data.status == 'open'
          && request.resource.data.keys().hasOnly(['teamId', 'role', 'proof', 'claimedAt'])
          && request.resource.data.role == 'team'
          && request.resource.data.teamId is string
          && exists(/databases/$(database)/documents/workshops/$(workshopId)/teamSecrets/$(request.resource.data.teamId))
          && request.resource.data.proof == get(/databases/$(database)/documents/workshops/$(workshopId)/teamSecrets/$(request.resource.data.teamId)).data.proof;
        allow update, delete: if ownsWorkshop(workshopId);
      }

      match /teams/{teamId} {
        allow read: if ownsWorkshop(workshopId)
          || (hasMembership(workshopId) && memberTeam(workshopId) == teamId);
        allow create, delete: if ownsWorkshop(workshopId);
        allow update: if ownsWorkshop(workshopId)
          || (
            hasMembership(workshopId)
            && memberTeam(workshopId) == teamId
            && resource.data.locked != true
            && get(/databases/$(database)/documents/workshops/$(workshopId)).data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'state', 'progress', 'metrics', 'currentSection', 'updatedAt', 'lastSeen',
              'stateRevision', 'activeDevices'
            ])
          );
      }

      match /public/{documentId} {
        allow read: if ownsWorkshop(workshopId) || hasMembership(workshopId);
        allow create, update, delete: if ownsWorkshop(workshopId);
      }
    }
  }
}
